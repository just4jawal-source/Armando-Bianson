rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an authorized admin
    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'arman.bianson@yahoo.com' ||
        request.auth.token.email == 'just4jawal@gmail.com'
      );
    }

    // Projects collection: Anyone can read published projects, admins can read and write all
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Profile & site settings: Public read, admin write
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Site settings or meta info
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
  }
}
